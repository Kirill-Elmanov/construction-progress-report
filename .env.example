# ── База данных (MVP: PG в Docker на ВМ / локально) ──
DATABASE_URL="postgresql://rost:rost_dev_password@localhost:5432/rost_report?schema=public"

# ── JWT (сессии stateless, Redis НЕ используется — ТЗ п.4.6) ──
JWT_SECRET="change-me-in-lockbox"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
BOOTSTRAP_TOKEN="local-demo-bootstrap-token"
SUPERADMIN_EMAIL="demo.admin@example.test"

# ── CORS (ТЗ 4.6: домен НЕ хардкодится) ──
ALLOWED_ORIGINS="http://localhost:3000"

# ── Справочник руководителей Google Sheets (Правки v5) ──
# Файл → Поделиться → Опубликовать в интернете → CSV, затем вставить URL.
GOOGLE_PARTICIPANTS_CSV_URL=""

# ── Реестр РД → секция В (Правки v6) ──
# Основной вариант: ссылка задаётся суперадмином в карточке проекта.
# Эти переменные оставлены как общий резервный источник для старых проектов.
RD_SHEET_ID=""
RD_SHEET_NAME="Реестр РД"
# Вместо ID можно указать полный опубликованный CSV URL:
RD_SHEET_CSV_URL=""

# ── PLAN-R Public API → график работ (Правки v6) ──
# Базовый адрес должен оканчиваться на /public-api/
PLANR_BASE_URL="https://plan-r.example.ru/public-api/"
# Токен хранится только здесь; в карточку проекта и базу данных не попадает.
PLANR_TOKEN=""
PLANR_TENANT_ID=""
PLANR_API_VERSION="409"
# Production: путь к корпоративному корневому сертификату PLAN-R.
PLANR_CA_CERT_PATH=""
# Только локальная разработка: отключает проверку TLS лишь для PLAN-R.
PLANR_TLS_INSECURE="false"
# Ограничение PLAN-R учтено в коде: последовательные страницы, общий интервал
# между запросами, кэш на 2 минуты и повтор с Retry-After при HTTP 429.

# ── Object Storage (фото, PDF) ──
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET_PHOTOS="rost-photos"
S3_BUCKET_PDF="rost-pdf"
S3_ACCESS_KEY_ID="rost-dev"
S3_SECRET_ACCESS_KEY="rost-dev-secret"

# ── PDF Cloud Function (MVP: прямой вызов, без YMQ — ТЗ 4.7) ──
PDF_FUNCTION_URL=""
INTERNAL_TOKEN="change-me-in-lockbox"

# ── Часовой пояс отчётности (ТЗ 4.6) ──
REPORT_TZ="Europe/Moscow"
